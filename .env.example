# Matrix Client Configuration
ACCESS_TOKEN="your_matrix_access_token_here"
MATRIX_ROOM_ID="!your_room_id:matrix.org"

# Hugging Face Configuration (Optional - to prevent API rate limits when downloading dataset)
HF_TOKEN="your_huggingface_token_here"

# Ollama (Required for LLM generation)
# Ensure Ollama is installed and running locally.
OLLAMA_API_BASE="http://localhost:11434"
# Note: Embeddings use sentence-transformers locally (no API key needed).
# The model "all-MiniLM-L6-v2" is downloaded once automatically on first run.

# Langfuse Observability (Required for tracing - Week 16)
# Sign up at https://cloud.langfuse.com to get these keys
LANGFUSE_PUBLIC_KEY="pk-lf-your_public_key_here"
LANGFUSE_SECRET_KEY="sk-lf-your_secret_key_here"
LANGFUSE_HOST="https://cloud.langfuse.com"
